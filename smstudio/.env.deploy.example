# ============================================================
#  Настройки сервера (Docker).
#  Скопируйте в .env.deploy и замените все CHANGE_ME.
#
#  Запуск:  docker compose --env-file .env.deploy up -d --build
# ============================================================

# --- Django ---
DEBUG=False
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_SECRET_KEY
ALLOWED_HOSTS=smfoto54.ru,www.smfoto54.ru
CSRF_TRUSTED_ORIGINS=https://smfoto54.ru,https://www.smfoto54.ru,http://smfoto54.ru,http://www.smfoto54.ru

# --- База данных (MySQL из compose) ---
DATABASE_ENGINE=mysql
DATABASE_NAME=_smart
# На существующем томе MySQL пользователь должен совпадать с уже созданным там
DATABASE_USER=smart
DATABASE_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DATABASE_HOST=db
DATABASE_PORT=3306

# --- Gunicorn ---
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# --- Nginx Proxy Manager ---
# Имя docker-сети, в которой живёт NPM. Посмотреть: docker network ls
# Обычно npm_default / nginx-proxy-manager_default / npm-app_default.
# Контейнер smstudio-nginx подключается к ней, и NPM проксирует на smstudio-nginx:80
NPM_NETWORK=npm_default

# --- HTTPS (раскомментировать, когда сайт реально отдаётся по https) ---
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
